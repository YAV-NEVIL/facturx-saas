# Configuration Supabase Cloud (A renseigner dans Vercel Environment Variables)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Passerelle d'Envoi Reel d'Emails (Factures PDF, Relances, KYB, Gold)
# Option 1 : Resend (https://resend.com)
# RESEND_API_KEY=re_xxxxxxxxxxxxx
# FACTURX_FROM_EMAIL=FacturX <facturation@votredomaine.cd>

# Option 2 : Brevo (https://brevo.com - 300 emails/jour gratuits meme avec Gmail)
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxxx
# FACTURX_SENDER_EMAIL=votreemail@gmail.com

# Option 3 : SMTP Standard (Gmail Mot de passe d'application, Zoho, OVH, Hostinger...)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=votreemail@gmail.com
# SMTP_PASS=votre-mot-de-passe-application

# Email de reception pour les dossiers KYB et demandes Offre Gold
# FACTURX_ADMIN_EMAIL=facturx01@gmail.com
